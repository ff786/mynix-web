# Copy to .env for local runs. On AWS, set these as the service's environment
# variables (DATABASE_URL via Secrets Manager).
NODE_ENV=development
PORT=4000

# Supabase → Project Settings → Database → Connection string → "Session pooler"
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=10

# Supabase project URL (sign-in tokens are checked against its public keys)
SUPABASE_URL=https://your-project-ref.supabase.co

# Sites allowed to call the API from a browser, comma-separated
CORS_ORIGINS=http://localhost:3000,https://mynix-web.vercel.app
