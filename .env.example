# Copy to .env.local for local work, and add the same values in Vercel →
# Project → Settings → Environment Variables. See ADMIN_SETUP.md.

# Newsletter notifications via Resend (resend.com → API Keys)

# POS connection (server-only; never exposed to browsers). The account must
# have the ONLINE_STORE role. For local testing, ./local-stack/setup.sh fills
# these in automatically.
POS_API_URL=https://api.mynix.lk/api
POS_STORE_USERNAME=online-store
POS_STORE_PASSWORD=

# Flat delivery fee in LKR added to each order (0 = free delivery)
DELIVERY_FEE_LKR=0

# Signs customer sign-in cookies (32+ random characters, e.g. openssl rand -hex 32)
CUSTOMER_SESSION_SECRET=
