# Copy to .env.local for local work (./local-stack/setup.sh fills in the POS
# values), and add the same values in Vercel → Project → Settings →
# Environment Variables. Everything is server-only.

# POS connection (server-only; never exposed to browsers). The account must
# have the ONLINE_STORE role. For local testing, ./local-stack/setup.sh fills
# these in automatically.
POS_API_URL=https://api.mynix.lk/api
POS_STORE_USERNAME=online-store
POS_STORE_PASSWORD=

# Flat delivery fee in LKR added to each order (0 = free delivery)
DELIVERY_FEE_LKR=0

# Signs customer sign-in cookies (32+ random characters, e.g. openssl rand -hex 32)
CUSTOMER_SESSION_SECRET=

# SEO. SITE_URL is the canonical origin — the host that serves pages, not one
# that redirects (defaults to https://www.mynix.lk). GOOGLE_SITE_VERIFICATION is
# the content value of Search Console's HTML-tag method (not needed if the
# domain is verified by DNS).
SITE_URL=https://www.mynix.lk
GOOGLE_SITE_VERIFICATION=

# Card payments (OnePay). All server-only: never prefix with NEXT_PUBLIC_.
# Card payment switches on only when App ID, Hash Salt, App Token, Callback Token and PAYMENT_STATE_SECRET are set (and SITE_URL is https).
# App ID and Hash Salt: OnePay merchant dashboard → API Keys (sandbox and live differ).
ONEPAY_APP_ID=
ONEPAY_HASH_SALT=
# App Token: same place; sent as the Authorization header on every OnePay request.
ONEPAY_APP_TOKEN=
# Leave empty: sandbox and live share https://api.onepay.lk and differ by credentials. Only for a local stand-in.
ONEPAY_API_URL=
# Encrypts the checkout details that wait in the customer's cookie while they pay
# (32+ random characters, e.g. openssl rand -hex 32). Use a different value from the others.
PAYMENT_STATE_SECRET=

# Callback Token configured for the app in OnePay. OnePay sends it as the webhook's
# Authorization header; webhooks without it are refused.
ONEPAY_CALLBACK_TOKEN=
