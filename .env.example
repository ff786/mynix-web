# Copy to .env.local for local work, and add the same values in Vercel →
# Project → Settings → Environment Variables. See ADMIN_SETUP.md.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Newsletter notifications via Resend (resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where new-subscriber emails are sent
NEWSLETTER_NOTIFY_EMAIL=you@example.com
# Sender. Until you verify a domain in Resend, keep the default below —
# it can only deliver to the email address you signed up to Resend with.
NEWSLETTER_FROM_EMAIL=MYNIX Website <onboarding@resend.dev>
